# Copy to .env and choose your own demo password (10+ characters).
SEED_DEMO=true
DEMO_PASSWORD=
DATABASE_PATH=./data/ems.sqlite
PORT=3001
HOST=127.0.0.1
# Set NODE_ENV=production behind HTTPS for Secure cookies.

# Public application origin used for Google OAuth redirects (no trailing path).
APP_URL=http://127.0.0.1:3001

# Optional social sign-in. Leave blank to use email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
